# ==============================
# DJANGO SETTINGS
# ==============================
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=your-super-secret-key-here-change-this

# ==============================
# DATABASE
# ==============================
DATABASE_URL=postgresql://user:password@host:5432/travel_agency

# ==============================
# STRIPE
# ==============================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...

# ==============================
# CLOUDINARY (Images)
# ==============================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ==============================
# EMAIL (Render: HTTPS via Resend, after domain verification)
# ==============================
EMAIL_BACKEND=apps.core.email_backend.ResendEmailBackend
RESEND_API_KEY=your-resend-api-key
DEFAULT_FROM_EMAIL=Culture Hop Tours <info@culturehoptours.com>
# Setup: docs/EMAIL_RENDER_SETUP_FR.md

# ==============================
# CUSTOM DOMAIN (Optional)
# ==============================
CUSTOM_DOMAIN=agence-marrakech.com

# ==============================
# SECURITY (Render auto-handles HTTPS)
# ==============================
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
MOROCCO_SITE_URL=https://www.culturehoptours.com
CUSTOM_DOMAINS=culturehoptours.com,www.culturehoptours.com
